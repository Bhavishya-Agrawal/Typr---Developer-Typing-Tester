{
  "name": "typr-mern-stack",
  "version": "2.0.0",
  "description": "Typr_ – Developer Typing Platform (MERN Full-Stack Project)",
  "author": "Bhavishya Agrawal",
  "license": "MIT",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "start": "npm start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "build": "npm run build --workspace=client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
